# Default registry: Public npm (works for all contributors)
# No authentication required for public packages
registry=https://registry.npmjs.org/

# FamilySearch employees: You can optionally use Artifactory for faster builds
# by creating a local ~/.npmrc or .npmrc.local file with:
#   registry=https://npm.dev.fsglobal.org/
#   //npm.dev.fsglobal.org/:_authToken=${NPM_AUTH_TOKEN}

# Disable auth prompts for public registry
always-auth=false
