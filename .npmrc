# Default registry: Public npm (works for all contributors, no auth required).
# This repo is public, so external contributors and public GitHub Actions CI
# use this registry - they have no way to authenticate to FamilySearch's
# internal Artifactory.
registry=https://registry.npmjs.org/

# FamilySearch employees: FS Information Security standard requires using
# Artifactory - not the public npm registry - for local development and any
# FamilySearch-run build (see ARTIFACTORY_BUILD_PROCESS.md). A plain
# ~/.npmrc override does NOT work here - this committed file's `registry`
# setting always wins over your user-level config. Instead, set an
# environment variable (e.g. in ~/.zshrc), which does take precedence:
#   export NPM_CONFIG_REGISTRY=https://familysearch.jfrog.io/artifactory/api/npm/fs-npm-prod-virtual/
# Then run `npm login` (from a directory outside this repo) and follow the
# SAML SSO prompt to authenticate. Ask DPT/IS or an internal engineering
# channel if you need the onboarding guide for requesting Artifactory access.
